(module
  (import "host" "value" (global $value (mut i32)))
  (import "host" "constant" (global $constant i32))
  (import "host" "long" (global $long i64))
  (global $initial (export "initial") i32 (global.get $constant))
  (export "value" (global $value))
  (export "alias" (global $value))
  (export "constant" (global $constant))
  (export "long" (global $long))
  (func (export "read") (result i32) (global.get $value))
  (func (export "write") (param i32) (global.set $value (local.get 0)))
  (func (export "bump") (result i32)
    (global.set $value (i32.add (global.get $value) (i32.const 1))) (global.get $value))
)
