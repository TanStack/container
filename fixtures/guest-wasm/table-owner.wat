(module
  (type $unary (func (param i32) (result i32)))
  (import "host" "callback" (func $callback (type $unary)))
  (memory (export "memory") 1)
  (data (i32.const 0) "\11")
  (table $t (export "table") (export "alias") 2 8 funcref)
  (global $saved (mut funcref) (ref.null func))
  (func $read (export "read") (type $unary)
    local.get 0 call $callback i32.const 0 i32.load8_u i32.add)
  (func $double (export "double") (type $unary)
    local.get 0 i32.const 2 i32.mul)
  (elem (i32.const 0) $read $double)
  (func (export "call") (param i32 i32) (result i32)
    local.get 1 local.get 0 call_indirect (type $unary))
  (func (export "clear") (param i32)
    local.get 0 ref.null func table.set $t)
  (func (export "save") (param i32)
    local.get 0 table.get $t global.set $saved)
  (func (export "restore") (param i32)
    local.get 0 global.get $saved table.set $t)
  (func (export "dropSaved") ref.null func global.set $saved)
  (func (export "copy") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy $t $t)
  (func (export "fill") (param i32 i32)
    local.get 0 ref.func $double local.get 1 table.fill $t)
  (func (export "grow") (param i32) (result i32)
    ref.func $read local.get 0 table.grow $t))
