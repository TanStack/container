(module
  (type $unary (func (param i32) (result i32)))
  (import "host" "table" (table $t 2 8 funcref))
  (export "table" (table $t))
  (export "alias" (table $t))
  (memory (export "memory") 1)
  (data (i32.const 0) "\5d")
  (func (export "call") (param i32 i32) (result i32)
    local.get 1 local.get 0 call_indirect (type $unary))
  (func (export "tail") (param i32 i32) (result i32)
    local.get 1 local.get 0 return_call_indirect (type $unary))
  (func (export "callTwice") (param i32 i32) (result i32)
    local.get 1
    local.get 1 local.get 0 call_indirect (type $unary)
    local.get 1 local.get 0 call_indirect (type $unary)
    i32.add i32.add)
  (func (export "clear") (param i32)
    local.get 0 ref.null func table.set $t)
  (func (export "grow") (param i32) (result i32)
    ref.null func local.get 0 table.grow $t))
