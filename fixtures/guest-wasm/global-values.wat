(module
  (memory 1)
  (global $i (export "i") (export "alias") (mut i32) (i32.const 7))
  (global $l (export "l") (mut i64) (i64.const 9007199254740995))
  (global $f (export "f") (mut f32) (f32.const 1.5))
  (global $d (export "d") (mut f64) (f64.const -0))
  (global $constant (export "constant") i32 (i32.const 23))
  (func (export "read") (result i32) (global.get $i))
  (func (export "write") (param i32) (global.set $i (local.get 0)))
  (func (export "bump") (result i32)
    (global.set $i (i32.add (global.get $i) (i32.const 1))) (global.get $i))
  (func (export "readLong") (result i64) (global.get $l))
  (func (export "writeLong") (param i64) (global.set $l (local.get 0)))
)
