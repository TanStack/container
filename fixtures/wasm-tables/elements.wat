(module
  (type $answer (func (result i32)))
  (table $t 4 8 funcref)
  (func $first (type $answer) (result i32) i32.const 17)
  (func $second (type $answer) (result i32) i32.const 42)
  (elem (i32.const 0) $first $second)
  (elem $passive func $second $first)
  (func (export "call") (param i32) (result i32)
    local.get 0 call_indirect (type $answer))
  (func (export "clear") (param i32)
    local.get 0 ref.null func table.set $t)
  (func (export "copy") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy $t $t)
  (func (export "fill") (param i32 i32)
    local.get 0 ref.func $second local.get 1 table.fill $t)
  (func (export "init") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.init $t $passive)
  (func (export "drop") elem.drop $passive)
  (func (export "grow") (param i32) (result i32)
    ref.func $first local.get 0 table.grow $t)
  (func (export "size") (result i32) table.size $t))
