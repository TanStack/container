{
  "name": "workspace-lock-probe",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "workspace-lock-probe",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@probe/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@probe/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/app": {
      "name": "@probe/app",
      "version": "1.0.0",
      "dependencies": {
        "@probe/shared": "*"
      }
    },
    "packages/shared": {
      "name": "@probe/shared",
      "version": "1.0.0"
    }
  }
}
