+/* A contextified global is not a Proxy: Node's sandbox descriptors and the
+   realm's hidden declaration descriptors may legitimately differ. All values
+   here belong to the same QuickJS runtime; no host objects cross this bridge. */
+typedef struct QJSGlobalBridge {
+    JSValue sandbox;
+    JSValue backing;
+} QJSGlobalBridge;
+
+static JSClassID qjs_global_bridge_class;
+
+static void qjs_bridge_finalizer(JSRuntime *rt, JSValue obj)
+{
+    QJSGlobalBridge *s = JS_GetOpaque(obj, qjs_global_bridge_class);
+    if (s) {
+        JS_FreeValueRT(rt, s->sandbox);
+        JS_FreeValueRT(rt, s->backing);
+        js_free_rt(rt, s);
+    }
+}
+
+static void qjs_bridge_mark(JSRuntime *rt, JSValueConst obj, JS_MarkFunc *mark)
+{
+    QJSGlobalBridge *s = JS_GetOpaque(obj, qjs_global_bridge_class);
+    if (s) {
+        JS_MarkValue(rt, s->sandbox, mark);
+        JS_MarkValue(rt, s->backing, mark);
+    }
+}
+
+static int qjs_bridge_own(JSContext *ctx, JSPropertyDescriptor *desc,
+                          JSValueConst obj, JSAtom prop)
+{
+    QJSGlobalBridge *s = JS_GetOpaque(obj, qjs_global_bridge_class);
+    int ret = JS_GetOwnProperty(ctx, desc, s->sandbox, prop);
+    if (ret) return ret;
+    return JS_GetOwnProperty(ctx, desc, s->backing, prop);
+}
+
+static int qjs_bridge_has(JSContext *ctx, JSValueConst obj, JSAtom prop)
+{
+    QJSGlobalBridge *s = JS_GetOpaque(obj, qjs_global_bridge_class);
+    int ret = JS_HasProperty(ctx, s->sandbox, prop);
+    if (ret) return ret;
+    return JS_HasProperty(ctx, s->backing, prop);
+}
+
+static JSValue qjs_bridge_get(JSContext *ctx, JSValueConst obj, JSAtom prop,
+                              JSValueConst receiver)
+{
+    QJSGlobalBridge *s = JS_GetOpaque(obj, qjs_global_bridge_class);
+    JSValue result;
+    int ret = JS_HasProperty(ctx, s->sandbox, prop);
+    if (ret < 0) return JS_EXCEPTION;
+    result = ret ? JS_GetProperty(ctx, s->sandbox, prop) :
+        JS_GetPropertyInternal(ctx, s->backing, prop, obj, FALSE);
+    if (JS_IsObject(result) && JS_VALUE_GET_PTR(result) == JS_VALUE_GET_PTR(s->sandbox)) {
+        JS_FreeValue(ctx, result);
+        return JS_DupValue(ctx, obj);
+    }
+    return result;
+}
+
+static int qjs_bridge_set(JSContext *ctx, JSValueConst obj, JSAtom prop,
+                           JSValueConst value, JSValueConst receiver, int flags)
+{
+    QJSGlobalBridge *s = JS_GetOpaque(obj, qjs_global_bridge_class);
+    JSPropertyDescriptor desc;
+    int own = JS_GetOwnProperty(ctx, &desc, s->sandbox, prop), ret;
+    if (own < 0) return -1;
+    if (!JS_IsObject(receiver) || JS_VALUE_GET_PTR(receiver) != JS_VALUE_GET_PTR(obj)) {
+        if (own) js_free_desc(ctx, &desc);
+        ret = qjs_bridge_own(ctx, &desc, obj, prop);
+        if (ret < 0) return -1;
+        if (ret) {
+            BOOL read_only = (desc.flags & JS_PROP_TMASK) != JS_PROP_GETSET && !(desc.flags & JS_PROP_WRITABLE);
+            js_free_desc(ctx, &desc);
+            if (read_only) return JS_ThrowTypeErrorReadOnly(ctx, flags, prop);
+        }
+        if (!JS_IsObject(receiver)) return JS_ThrowTypeErrorOrFalse(ctx, flags, "receiver is not an object");
+        ret = JS_GetOwnProperty(ctx, &desc, receiver, prop);
+        if (ret < 0) return -1;
+        if (ret) {
+            BOOL read_only = (desc.flags & JS_PROP_TMASK) == JS_PROP_GETSET || !(desc.flags & JS_PROP_WRITABLE);
+            js_free_desc(ctx, &desc);
+            if (read_only) return JS_ThrowTypeErrorReadOnly(ctx, flags, prop);
+        }
+        return JS_DefineProperty(ctx, receiver, prop, value, JS_UNDEFINED, JS_UNDEFINED,
+            JS_PROP_HAS_VALUE | (ret ? 0 : JS_PROP_C_W_E | JS_PROP_HAS_CONFIGURABLE | JS_PROP_HAS_WRITABLE | JS_PROP_HAS_ENUMERABLE) | flags);
+    }
+    if (own) {
+        BOOL accessor = (desc.flags & JS_PROP_TMASK) == JS_PROP_GETSET;
+        BOOL writable = desc.flags & JS_PROP_WRITABLE;
+        JS_FreeValue(ctx, desc.value);
+        JS_FreeValue(ctx, desc.getter);
+        JS_FreeValue(ctx, desc.setter);
+        ret = JS_SetPropertyInternal(ctx, s->sandbox, prop, JS_DupValue(ctx, value), s->sandbox, flags);
+        if (ret <= 0 || accessor || !writable) return ret;
+    } else {
+        int backing = JS_GetOwnProperty(ctx, &desc, s->backing, prop);
+        if (backing < 0) return -1;
+        if (backing) {
+            BOOL read_only = (desc.flags & JS_PROP_TMASK) != JS_PROP_GETSET && !(desc.flags & JS_PROP_WRITABLE);
+            JS_FreeValue(ctx, desc.value);
+            JS_FreeValue(ctx, desc.getter);
+            JS_FreeValue(ctx, desc.setter);
+            if (read_only)
+                return JS_SetPropertyInternal(ctx, s->backing, prop, JS_DupValue(ctx, value), s->backing, flags);
+        }
+        ret = JS_IsExtensible(ctx, s->sandbox);
+        if (ret < 0) return -1;
+        if (ret) {
+            ret = JS_SetPropertyInternal(ctx, s->sandbox, prop, JS_DupValue(ctx, value), s->sandbox, flags);
+            if (ret <= 0) return ret;
+        }
+    }
+    /* Retain the last guest write behind declared bindings. For a frozen
+       sandbox, new assignments are still permitted on the realm's global. */
+    ret = JS_HasProperty(ctx, s->backing, prop);
+    if (ret < 0) return -1;
+    if (ret || !own) {
+        int extensible = JS_IsExtensible(ctx, s->sandbox);
+        if (extensible < 0) return -1;
+        if (ret || !extensible)
+            return JS_SetPropertyInternal(ctx, s->backing, prop, JS_DupValue(ctx, value), extensible ? obj : s->backing, flags);
+    }
+    return TRUE;
+}
+
+static int qjs_bridge_define(JSContext *ctx, JSValueConst obj, JSAtom prop,
+                              JSValueConst value, JSValueConst getter,
+                              JSValueConst setter, int flags)
+{
+    QJSGlobalBridge *s = JS_GetOpaque(obj, qjs_global_bridge_class);
+    int ret = JS_DefineProperty(ctx, s->sandbox, prop, value, getter, setter, flags);
+    if (ret <= 0) return ret;
+    return JS_DefineProperty(ctx, s->backing, prop, value, getter, setter, flags);
+}
+
+static int qjs_bridge_delete(JSContext *ctx, JSValueConst obj, JSAtom prop)
+{
+    QJSGlobalBridge *s = JS_GetOpaque(obj, qjs_global_bridge_class);
+    int ret = JS_DeleteProperty(ctx, s->sandbox, prop, 0);
+    if (ret <= 0) return ret;
+    return JS_DeleteProperty(ctx, s->backing, prop, 0);
+}
+
+static int qjs_bridge_names(JSContext *ctx, JSPropertyEnum **ptab, uint32_t *plen,
+                             JSValueConst obj)
+{
+    QJSGlobalBridge *s = JS_GetOpaque(obj, qjs_global_bridge_class);
+    JSPropertyEnum *a = NULL, *b = NULL, *out;
+    JSValue seen;
+    uint32_t na = 0, nb = 0, n = 0, i;
+    int flags = JS_GPN_STRING_MASK | JS_GPN_SYMBOL_MASK;
+    if (JS_GetOwnPropertyNames(ctx, &a, &na, s->backing, flags) < 0) return -1;
+    if (JS_GetOwnPropertyNames(ctx, &b, &nb, s->sandbox, flags) < 0) {
+        JS_FreePropertyEnum(ctx, a, na);
+        return -1;
+    }
+    out = js_malloc(ctx, ((size_t)na + nb + 1) * sizeof(*out));
+    if (!out) {
+        JS_FreePropertyEnum(ctx, a, na);
+        JS_FreePropertyEnum(ctx, b, nb);
+        return -1;
+    }
+    seen = JS_NewObjectProto(ctx, JS_NULL);
+    if (JS_IsException(seen)) goto fail;
+    for (i = 0; i < na; i++) {
+        if (js_poll_interrupts(ctx) || JS_DefinePropertyValue(ctx, seen, a[i].atom, JS_TRUE, 0) < 0) goto fail;
+        out[n].atom = JS_DupAtom(ctx, a[i].atom);
+        out[n++].is_enumerable = a[i].is_enumerable;
+    }
+    for (i = 0; i < nb; i++) {
+        if (js_poll_interrupts(ctx)) goto fail;
+        if (!JS_GetOwnProperty(ctx, NULL, seen, b[i].atom)) {
+            out[n].atom = JS_DupAtom(ctx, b[i].atom);
+            out[n++].is_enumerable = b[i].is_enumerable;
+        }
+    }
+    JS_FreeValue(ctx, seen);
+    JS_FreePropertyEnum(ctx, a, na);
+    JS_FreePropertyEnum(ctx, b, nb);
+    *ptab = out;
+    *plen = n;
+    return 0;
+ fail:
+    JS_FreeValue(ctx, seen);
+    JS_FreePropertyEnum(ctx, out, n);
+    JS_FreePropertyEnum(ctx, a, na);
+    JS_FreePropertyEnum(ctx, b, nb);
+    return -1;
+}
+
+static int qjs_bridge_prevent_extensions(JSContext *ctx, JSValueConst obj)
+{
+    return FALSE;
+}
+
+static JSValue qjs_bridge_prototype(JSContext *ctx, JSValueConst obj)
+{
+    QJSGlobalBridge *s = JS_GetOpaque(obj, qjs_global_bridge_class);
+    return JS_GetPrototype(ctx, s->backing);
+}
+
+static int qjs_bridge_set_prototype(JSContext *ctx, JSValueConst obj, JSValueConst proto)
+{
+    QJSGlobalBridge *s = JS_GetOpaque(obj, qjs_global_bridge_class);
+    JSObject *p = JS_IsObject(proto) ? JS_VALUE_GET_OBJ(proto) : NULL;
+    while (p) {
+        if (p == JS_VALUE_GET_OBJ(obj)) return FALSE;
+        p = p->shape->proto;
+    }
+    return JS_SetPrototypeInternal(ctx, s->backing, proto, FALSE);
+}
+
+static JSClassExoticMethods qjs_bridge_methods = {
+    .get_own_property = qjs_bridge_own,
+    .get_own_property_names = qjs_bridge_names,
+    .delete_property = qjs_bridge_delete,
+    .define_own_property = qjs_bridge_define,
+    .has_property = qjs_bridge_has,
+    .get_property = qjs_bridge_get,
+    .set_property = qjs_bridge_set,
+    .get_prototype = qjs_bridge_prototype,
+    .set_prototype = qjs_bridge_set_prototype,
+    .prevent_extensions = qjs_bridge_prevent_extensions,
+};
+
+static JSValue js_create_from_ctor(JSContext *ctx, JSValueConst ctor, int class_id);
+static JSValueConst JS_GetActiveFunction(JSContext *ctx);
+
+static JSValue qjs_global_constructor(JSContext *ctx, JSValueConst new_target,
+                                       int argc, JSValueConst *argv)
+{
+    return js_create_from_ctor(ctx, JS_IsUndefined(new_target) ? JS_GetActiveFunction(ctx) : new_target, JS_CLASS_OBJECT);
+}
+
+/* Trusted, one-time bootstrap hook. The embedder must capture and remove it
+   before running guest scripts, just like the string-generation policy hook. */
+static JSValue qjs_contextify_global(JSContext *ctx, JSValueConst this_val,
+                                      int argc, JSValueConst *argv)
+{
+    JSValue obj, vars, proto, ctor;
+    QJSGlobalBridge *s;
+    JSClassDef def = { "ContextGlobal", qjs_bridge_finalizer, qjs_bridge_mark, NULL, &qjs_bridge_methods };
+    if (argc < 1 || !JS_IsObject(argv[0])) return JS_ThrowTypeErrorNotAnObject(ctx);
+    if (!JS_IsUndefined(ctx->global_bridge_vars)) return JS_ThrowTypeError(ctx, "Global is already contextified");
+    JS_NewClassID(&qjs_global_bridge_class);
+    if (!JS_IsRegisteredClass(ctx->rt, qjs_global_bridge_class) &&
+        JS_NewClass(ctx->rt, qjs_global_bridge_class, &def) < 0) return JS_EXCEPTION;
+    obj = JS_NewObjectProtoClass(ctx, JS_NULL, qjs_global_bridge_class);
+    if (JS_IsException(obj)) return obj;
+    s = js_mallocz(ctx, sizeof(*s));
+    if (!s) { JS_FreeValue(ctx, obj); return JS_EXCEPTION; }
+    s->sandbox = JS_DupValue(ctx, argv[0]);
+    s->backing = JS_DupValue(ctx, ctx->global_obj);
+    JS_SetOpaque(obj, s);
+    vars = JS_NewObjectProtoClass(ctx, JS_NULL, JS_CLASS_GLOBAL_OBJECT);
+    if (JS_IsException(vars)) { JS_FreeValue(ctx, obj); return vars; }
+    JS_VALUE_GET_OBJ(vars)->u.global_object.uninitialized_vars = JS_NewObjectProto(ctx, JS_NULL);
+    if (JS_IsException(JS_VALUE_GET_OBJ(vars)->u.global_object.uninitialized_vars)) {
+        JS_FreeValue(ctx, vars); JS_FreeValue(ctx, obj); return JS_EXCEPTION;
+    }
+    if (JS_DeleteProperty(ctx, s->backing, JS_ATOM_Symbol_toStringTag, JS_PROP_THROW) < 0) {
+        JS_FreeValue(ctx, vars); JS_FreeValue(ctx, obj); return JS_EXCEPTION;
+    }
+    proto = JS_NewObject(ctx);
+    if (JS_IsException(proto)) {
+        JS_FreeValue(ctx, vars); JS_FreeValue(ctx, obj); return JS_EXCEPTION;
+    }
+    ctor = JS_NewCFunction2(ctx, qjs_global_constructor, "", 0, JS_CFUNC_constructor_or_func, 0);
+    if (JS_IsException(ctor) || JS_SetConstructor(ctx, ctor, proto) < 0 || JS_SetPrototype(ctx, s->backing, proto) < 0) {
+        JS_FreeValue(ctx, ctor);
+        JS_FreeValue(ctx, proto); JS_FreeValue(ctx, vars); JS_FreeValue(ctx, obj); return JS_EXCEPTION;
+    }
