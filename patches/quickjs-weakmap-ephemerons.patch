+/* A weak entry is an ephemeron: its value is reachable only when both
+   the map and its key are reachable. Symbol keys are conservatively
+   retained here because symbols are reference counted outside this
+   collector's object graph. */
+static BOOL gc_scan_weak_maps(JSRuntime *rt, BOOL restore_inactive)
+{
+    struct list_head *el, *entry;
+    BOOL changed = FALSE;
+
+    list_for_each(el, &rt->gc_obj_list) {
+        JSGCObjectHeader *gp = list_entry(el, JSGCObjectHeader, link);
+        JSObject *p;
+        JSMapState *s;
+        if (gp->gc_obj_type != JS_GC_OBJ_TYPE_JS_OBJECT)
+            continue;
+        p = (JSObject *)gp;
+        if (p->class_id != JS_CLASS_WEAKMAP || !p->u.map_state)
+            continue;
+        s = p->u.map_state;
+        list_for_each(entry, &s->records) {
+            JSMapRecord *mr = list_entry(entry, JSMapRecord, link);
+            if (mr->empty || mr->gc_active)
+                continue;
+            if (restore_inactive) {
+                JS_MarkValue(rt, mr->value, gc_scan_incref_child2);
+            } else if (!JS_IsObject(mr->key) ||
+                       (!JS_VALUE_GET_OBJ(mr->key)->free_mark &&
+                        JS_VALUE_GET_OBJ(mr->key)->header.mark == 0)) {
+                mr->gc_active = TRUE;
+                JS_MarkValue(rt, mr->value, gc_scan_incref_child);
+                changed = TRUE;
+            }
+        }
+    }
+    return changed;
 }
 
