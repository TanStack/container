+// The host Wasm call stack is separate from its linear-memory C stack.
+// Count frames retained across inner dispatch, including nested loops.
+#ifndef d_m3MaxActiveFrames
+#  define d_m3MaxActiveFrames 256
+#endif
+#define d_m3FrameEnter()                                                   \
+    do {                                                                  \
+        if (m3MemRuntime (_mem)->activeFrames >= d_m3MaxActiveFrames)        \
+            newTrap ("[trap] stack overflow (interpreter frame limit)");    \
+        m3MemRuntime (_mem)->activeFrames++;                               \
+    } while (0)
+#define d_m3FrameLeave()                                                   \
+    do {                                                                  \
+        m3MemRuntime (_mem)->activeFrames--;                               \
+    } while (0)
+
+
